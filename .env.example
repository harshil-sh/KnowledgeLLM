# Copy this file to .env before running docker compose.
# Do not commit real secrets in .env.

# API
KNOWLEDGELLM_API_PORT=5000
KNOWLEDGELLM__OPENAI__APIKEY=sk-your-openai-api-key
KNOWLEDGELLM__OPENAI__EMBEDDINGMODEL=text-embedding-3-small
KNOWLEDGELLM__OPENAI__CHATMODEL=gpt-4o-mini
KNOWLEDGELLM__OPENAI__EMBEDDINGDIMENSIONS=1536
KNOWLEDGELLM__API__APIKEY=

# PostgreSQL / pgvector
POSTGRES_DB=knowledgellm
POSTGRES_USER=knowledgellm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
